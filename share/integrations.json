{
  "version": 1,
  "apps": [
    {
      "name": "ghostty",
      "reload": ["pkill", "-USR2", "-f", "^ghostty( |$)"],
      "reload_output": "show",
      "note": "Ghostty reloads its config on SIGUSR2",
      "outputs": [
        { "kind": "hook", "switch": "theme", "dir": "colors_dir", "file": "ghostty", "generator": "ghostty-colors.sh" },
        { "kind": "jq", "switch": "fonts", "dir": "fonts_dir", "file": "ghostty", "generator": "ghostty-font.jq" }
      ]
    },
    {
      "name": "i3",
      "reload": ["i3-msg", "restart"],
      "reload_output": "hide",
      "note": "the restart applies the colours, the window-title font and the bar font",
      "outputs": [
        { "kind": "jq", "switch": "theme", "dir": "colors_dir", "file": "i3", "generator": "i3-colors.jq" },
        { "kind": "jq", "switch": "fonts", "dir": "fonts_dir", "file": "i3", "generator": "i3-font.jq" }
      ]
    },
    {
      "name": "rofi",
      "outputs": [
        { "kind": "jq", "switch": "theme", "dir": "colors_dir", "file": "rofi.rasi", "generator": "rofi-colors.jq" },
        { "kind": "jq", "switch": "fonts", "dir": "fonts_dir", "file": "rofi.rasi", "generator": "rofi-font.jq" }
      ]
    },
    {
      "name": "shell",
      "outputs": [
        { "kind": "jq", "switch": "theme", "dir": "colors_dir", "file": "colors.sh", "generator": "shell-colors.jq" }
      ]
    },
    {
      "name": "lock-screen",
      "outputs": [
        { "kind": "hook", "switch": "fonts", "dir": "fonts_dir", "file": "lock.sh", "generator": "lock-font.sh" }
      ]
    },
    {
      "name": "gtk",
      "outputs": [
        { "kind": "script", "switch": "fonts", "generator": "gtk-font.sh" }
      ]
    },
    {
      "name": "fontconfig",
      "outputs": [
        { "kind": "hook", "switch": "fonts", "dir": "fontconfig_dir", "file": "60-theme-fonts.conf", "generator": "fontconfig-font.sh" }
      ]
    },
    {
      "name": "pywalfox",
      "reload": ["pywalfox", "update"],
      "reload_output": "hide-all",
      "outputs": [
        { "kind": "jq", "switch": "theme", "dir": "cache_dir", "file": "colors.json", "generator": "pywalfox-colors.jq" }
      ]
    }
  ]
}
