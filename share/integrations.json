{
  "version": 1,
  "apps": [
    {
      "name": "i3",
      "outputs": [
        { "kind": "jq", "dir": "colors_dir", "file": "i3", "generator": "i3-colors.jq" }
      ]
    },
    {
      "name": "rofi",
      "outputs": [
        { "kind": "jq", "dir": "colors_dir", "file": "rofi.rasi", "generator": "rofi-colors.jq" }
      ]
    },
    {
      "name": "shell",
      "outputs": [
        { "kind": "jq", "dir": "colors_dir", "file": "colors.sh", "generator": "shell-colors.jq" }
      ]
    },
    {
      "name": "ghostty",
      "outputs": [
        { "kind": "hook", "dir": "colors_dir", "file": "ghostty", "generator": "ghostty-colors.sh" }
      ]
    },
    {
      "name": "pywalfox",
      "outputs": [
        { "kind": "jq", "dir": "cache_dir", "file": "colors.json", "generator": "pywalfox-colors.jq" }
      ]
    }
  ]
}
